{
  "name": "mossboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --filter @mossboard/web build",
    "check": "pnpm typecheck && pnpm build",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "typecheck": "pnpm --recursive typecheck && tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.108",
    "@effect/platform-node": "4.0.0-rc.108",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3"
  }
}
